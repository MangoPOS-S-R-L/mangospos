# =============================================================================
# Edge Functions Azul Subscriptions — variables de entorno requeridas.
#
# COPIA este archivo a `.env.local` (ignorado por git) o configura las
# variables directamente en tu stack Supabase (Coolify env vars del container
# `functions` o equivalente). NUNCA commits secrets reales.
#
# Lista exhaustiva validada por supabase/functions/_shared/env.ts en startup.
# Si falta alguna requerida, la función lanza al primer request.
# =============================================================================

# Ambiente Azul — controla qué endpoint se usa por defecto.
# test | production
AZUL_ENV=test

# MID provisto por Azul.
AZUL_MERCHANT_ID=39038540035

# Identidad del comercio. MerchantName aparece en estados de cuenta del cliente.
AZUL_MERCHANT_NAME=MangoPOS
AZUL_MERCHANT_TYPE=ECommerce
AZUL_CURRENCY_CODE=$

# -----------------------------------------------------------------------------
# Integración API directa (mTLS + Auth1/Auth2)
# -----------------------------------------------------------------------------

# Endpoint del Webservices JSON de Azul.
# - Pruebas: https://pruebas.azul.com.do/webservices/JSON/Default.aspx
# - Producción: https://pagos.azul.com.do/webservices/JSON/Default.aspx
# - Contingencia: https://contpagos.azul.com.do/webservices/JSON/Default.aspx
AZUL_API_URL=https://pruebas.azul.com.do/webservices/JSON/Default.aspx

# Credenciales adicionales que Azul entrega junto con el cert mTLS.
# En pruebas son típicamente "splitit" / "splitit". En producción son los
# valores definitivos asignados por Azul al comercio.
AZUL_AUTH1=splitit
AZUL_AUTH2=splitit

# Path absoluto al cert + private key DENTRO del container que corre las
# edge functions. Debe coincidir con el bind-mount del docker-compose
# (volumes/azul-certs:/home/deno/functions/azul-certs:ro).
AZUL_CERT_PATH=/home/deno/functions/azul-certs/mangopos-azul.crt
AZUL_KEY_PATH=/home/deno/functions/azul-certs/mangopos-azul.key

# -----------------------------------------------------------------------------
# Payment Page (LEGACY — se elimina en B4 junto con las funciones viejas)
# -----------------------------------------------------------------------------
# AZUL_AUTH_KEY=...
# AZUL_PAYMENT_PAGE_URL=https://pruebas.azul.com.do/PaymentPage/

# -----------------------------------------------------------------------------
# Smoke test (opcional, solo mientras existe _test-azul-mtls)
# -----------------------------------------------------------------------------
# Cualquier string aleatorio largo. Sin este var, el endpoint responde 503.
# MANGOPOS_SMOKE_KEY=replace_with_random_long_token

# -----------------------------------------------------------------------------
# URLs de callback y retorno
# -----------------------------------------------------------------------------

# Base de las Edge Functions (NO termina con /).
# Self-hosted Coolify típico: https://supabase.tudominio.com/functions/v1
PUBLIC_CALLBACK_BASE_URL=https://supabase.tudominio.com/functions/v1

# URL base donde el cliente regresa después de pagar / tokenizar.
PUBLIC_RETURN_BASE_URL=https://mangopos.do

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://supabase.tudominio.com
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY_REPLACE_BEFORE_DEPLOY
