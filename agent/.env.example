# MangoPOS Print Agent - configuración local.
# Copia este archivo a `.env` y completa con tus valores.

# === Identificación del agent ===
# AGENT_ID: nombre legible (legacy). Usado en logs.
AGENT_ID=caja-principal-01
AGENT_NAME=Caja Principal

# === Servidor HTTP local del agent ===
# Puerto donde el agent escucha. Default 4000.
LOCAL_PORT=4000

# === Sprint 1.2: Cloud queue (Supabase) ===
# Si están seteados, el agent toma jobs DIRECTAMENTE de Supabase
# (fuente de verdad). Si NO, sigue funcionando solo con cola SQLite
# local (modo legacy compatible con frontend viejo).

# URL de tu proyecto Supabase. Ej: https://abcdefgh.supabase.co
SUPABASE_URL=

# Service role key del proyecto. Encontrala en:
# Supabase Dashboard > Settings > API > service_role secret.
# IMPORTANTE: solo va en el agent (server-side). NO en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# UUID de device_agents.id que representa este device. Debe coincidir
# con el UUID que registra Flutter al arrancar en este mismo device.
# Si no se configura, el cloud worker queda deshabilitado.
AGENT_UUID=

# === Auth JWT (legacy) ===
# Shared secret HS256 con Supabase. Si está vacío, auth deshabilitado
# (modo legacy/dev — recomendado solo para troubleshooting).
JWT_SECRET=
# UUID del negocio. El JWT claim 'restaurant_id' o 'business_id' debe
# coincidir, o el agent devuelve 403.
RESTAURANT_ID=

# === Cloud backend legacy (Socket.IO) ===
# Solo si tenés un servidor central no-Supabase (raro).
BACKEND_URL=
AUTH_TOKEN=

# === Otros ===
LOG_LEVEL=info
PRINTER_WIDTH=48
