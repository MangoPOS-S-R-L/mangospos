<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="$(var.ProductName)"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="$(var.Manufacturer)"
    UpgradeCode="8D0F13E8-6A4B-4B62-9700-A4B2EBAA7C51"
    InstallerVersion="500"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una version mas reciente instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="MangoPOS">
        <Directory Id="APPDIR" Name="App" />
        <Directory Id="AGENTDIR" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="MangoPOS" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="APPDIR">
      <Component Id="cmpMainExe" Guid="A1111111-1111-4111-8111-111111111111">
        <File Id="filMainExe" Source="$(var.SourceDir)\App\mangopos.exe" KeyPath="yes" Checksum="yes" />
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="MangoPOS" WorkingDirectory="APPDIR" Target="[APPDIR]mangopos.exe" Advertise="no" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="MangoPOS" WorkingDirectory="APPDIR" Target="[APPDIR]mangopos.exe" Advertise="no" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AGENTDIR">
      <Component Id="cmpAgentService" Guid="A3333333-3333-4333-8333-333333333334">
        <!-- Wrapper de Servicio (WinSW) para Node.js -->
        <File Id="filServiceExe" Source="$(var.SourceDir)\Agent\mangopos-agent-service.exe" KeyPath="yes" Checksum="yes" />
        <File Id="filServiceXml" Source="$(var.SourceDir)\Agent\mangopos-agent-service.xml" />
        <File Id="filAgentExe" Source="$(var.SourceDir)\Agent\mangopos-agent.exe" />
        
        <ServiceInstall Id="ServiceInstallation"
          Type="ownProcess"
          Name="MangoPOSAgent"
          DisplayName="MangoPOS Print Agent"
          Description="Servicio de impresión de MangoPOS (Wrapper WinSW)."
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal" />
        
        <ServiceControl Id="StopStartService" Name="MangoPOSAgent" 
                        Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      
      <Component Id="cmpAgentConfig" Guid="A3333333-3333-4333-8333-333333333335">
        <File Id="filAgentYaml" Source="$(var.SourceDir)\Agent\config.yaml" />
        <File Id="filAgentEnv" Source="$(var.SourceDir)\Agent\.env" />
      </Component>
    </DirectoryRef>


    <Feature Id="ProductFeature" Title="MangoPOS" Level="1">
      <ComponentRef Id="cmpMainExe" />
      <ComponentRef Id="cmpAgentService" />
      <ComponentRef Id="cmpAgentConfig" />
      
      <!-- Incluimos el payload de Flutter (DLLs, data, etc.) pero EXCLUIMOS el exe que ya definimos -->
      <Files Directory="APPDIR" Include="$(var.SourceDir)\App\**">
        <Exclude Files="$(var.SourceDir)\App\mangopos.exe" />
      </Files>
    </Feature>



  </Package>
</Wix>
