<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="$(var.ProductName)"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="$(var.Manufacturer)"
    UpgradeCode="8D0F13E8-6A4B-4B62-9700-A4B2EBAA7C51"
    InstallerVersion="500"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una version mas reciente instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="MangoPOS">
        <Directory Id="APPDIR" Name="App" />
        <Directory Id="AGENTDIR" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="MangoPOS" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="APPDIR">
      <Component Id="cmpMainExe" Guid="A1111111-1111-4111-8111-111111111111" Win64="yes">
        <File Id="filMainExe" Source="$(var.SourceDir)\App\mangopos.exe" KeyPath="yes" Checksum="yes" />
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuDir" Name="MangoPOS" WorkingDirectory="APPDIR" Target="[APPDIR]mangopos.exe" Advertise="no" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="MangoPOS" WorkingDirectory="APPDIR" Target="[APPDIR]mangopos.exe" Advertise="no" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AGENTDIR">
      <Component Id="cmpAgentService" Guid="A3333333-3333-4333-8333-333333333334" Win64="yes">
        <!-- Instalacion NATIVA del Servicio (Sin .bat) -->
        <File Id="filAgentExe" Source="$(var.SourceDir)\Agent\mangopos-agent.exe" KeyPath="yes" Checksum="yes" />
        <ServiceInstall Id="ServiceInstallation"
          Type="ownProcess"
          Name="MangoPOSAgent"
          DisplayName="MangoPOS Print Agent"
          Description="Servicio de impresión local para MangoPOS."
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal" />
        <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="MangoPOSAgent" Wait="yes" />
      </Component>
      
      <Component Id="cmpAgentConfig" Guid="A3333333-3333-4333-8333-333333333335" Win64="yes">
        <File Id="filAgentEnv" Source="$(var.SourceDir)\Agent\.env" />
        <File Id="filAgentYaml" Source="$(var.SourceDir)\Agent\config.yaml" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="MangoPOS" Level="1">
      <ComponentRef Id="cmpMainExe" />
      <ComponentRef Id="cmpAgentService" />
      <ComponentRef Id="cmpAgentConfig" />
      
      <!-- Usamos el formato bulk de WiX v4/v7 que ya te funcionó antes -->
      <Files Directory="APPDIR" Include="$(var.SourceDir)\App\**">
        <Exclude Files="$(var.SourceDir)\App\mangopos.exe" />
      </Files>
      
      <Files Directory="AGENTDIR" Include="$(var.SourceDir)\Agent\**">
        <Exclude Files="$(var.SourceDir)\Agent\mangopos-agent.exe;$(var.SourceDir)\Agent\config.yaml;$(var.SourceDir)\Agent\.env" />
      </Files>
    </Feature>

  </Package>
</Wix>
