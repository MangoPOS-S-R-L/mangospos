# =============================================================================
# Edge Functions Azul Subscriptions — variables de entorno requeridas.
#
# COPIA este archivo a `.env.local` (ignorado por git) o configura las
# variables directamente en tu stack Supabase (Coolify env vars del container
# `functions` o equivalente). NUNCA commits secrets reales.
#
# Lista exhaustiva validada por supabase/functions/_shared/env.ts en startup.
# Si falta alguna requerida, la función lanza al primer request.
# =============================================================================

# Ambiente Azul — controla el endpoint de Payment Page por defecto.
# test | production
AZUL_ENV=test

# MID y AuthKey provistos por Azul. AuthKey es el secreto más sensible:
# si se filtra, cualquiera puede firmar transacciones contra el MID.
AZUL_MERCHANT_ID=39038540035
AZUL_AUTH_KEY=PLACEHOLDER_AZUL_AUTH_KEY_REPLACE_BEFORE_PROD

# Identidad del comercio en el form Azul. MerchantName aparece en la página de pago.
AZUL_MERCHANT_NAME=MangoPOS
AZUL_MERCHANT_TYPE=ECommerce

# CurrencyCode de Azul = "$" (literal, no código ISO). El doc lo confirma.
AZUL_CURRENCY_CODE=$

# Endpoint del Payment Page de Azul.
# - Pruebas: https://pruebas.azul.com.do/PaymentPage/
# - Producción principal: https://pagos.azul.com.do/PaymentPage/Default.aspx
# - Producción contingencia: https://contpagos.azul.com.do/PaymentPage/Default.aspx
AZUL_PAYMENT_PAGE_URL=https://pruebas.azul.com.do/PaymentPage/

# URL base de las Edge Functions (NO termina con /). Azul redirige callbacks
# a `${PUBLIC_CALLBACK_BASE_URL}/azul-callback?...`, y el form-server arma
# las URLs de approved/declined/cancel apuntando acá.
# Self-hosted Coolify típico: https://supabase.tudominio.com/functions/v1
PUBLIC_CALLBACK_BASE_URL=https://supabase.tudominio.com/functions/v1

# URL base donde el cliente regresa después del Payment Page. Páginas posibles:
#   - /onboarding/payment-result?result=approved
#   - /onboarding/payment-result?result=declined&reason=...
#   - /onboarding/payment-result?result=cancelled
#   - /onboarding/payment-result?result=error
PUBLIC_RETURN_BASE_URL=https://mangopos.do

# Conexión a Supabase. En self-hosted, SUPABASE_URL es la URL pública o
# interna del Kong (api gateway). Service role key es secreto crítico.
SUPABASE_URL=https://supabase.tudominio.com
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY_REPLACE_BEFORE_DEPLOY
